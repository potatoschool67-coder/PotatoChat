generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  bio           String?
  password      String
  avatar        String?
  status        String    @default("offline")
  theme         String    @default("dark")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  servers       ServerMember[]
  messages      Message[]
  relationships Relationship[] @relation("UserToRelationship")
  receivedMessages Message[] @relation("UserToRelationship")
  votes         Vote[]
}

model Server {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  icon        String?
  isPrivate   Boolean   @default(false)
  password    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members     ServerMember[]
  channels    Channel[]

  @@index([name])
}

model Channel {
  id          String    @id @default(cuid())
  name        String
  type        String    @default("TEXT")
  serverId    String
  isPrivate   Boolean   @default(false)
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages    Message[]
  permissions ChannelPermission[]
}

model ChannelPermission {
  id        String  @id @default(cuid())
  channelId String
  userId    String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

model Message {
  id          String    @id @default(cuid())
  content     String
  isEncrypted Boolean  @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  channelId   String?
  channel     Channel?  @relation(fields: [channelId], references: [id])
  recipientId String?
  recipient   User?     @relation("UserToRelationship", fields: [recipientId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  poll        Poll?
}

model Relationship {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserToRelationship", fields: [userId], references: [id])
  recipientId String
  createdAt   DateTime  @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  question  String
  messageId String   @unique
  createdAt DateTime @default(now())

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   Vote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  text   String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  Vote[]
}

model Vote {
  id        String   @id @default(cuid())
  optionId  String
  userId    String
  pollId    String
  createdAt DateTime @default(now())

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id])
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
}

model ServerMember {
  id       String @id @default(cuid())
  userId   String
  serverId String
  role     String @default("GUEST")

  user    User   @relation(fields: [userId], references: [id])
  server  Server @relation(fields: [serverId], references: [id])

  @@unique([userId, serverId])
}
